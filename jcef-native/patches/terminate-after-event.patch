+// Whether terminate: was called by _terminateNow:, from the top of the run loop.
+static bool g_terminate_now = false;
+
+// Calls terminate: from the run loop, outside of what asked for it.
+- (void)_terminateNow:(id)sender {
+  g_terminate_now = true;
+  [self terminate:sender];
+}
+
 // This method will be called via Cmd+Q.
 - (void)_swizzled_terminate:(id)sender {
+  // An application that answers the Quit later (NSTerminateLater) quits inside terminate:, in a run loop of AppKit's own, and inside what
+  // called it: Cmd+Q's key event (a key equivalent), or a task of Chromium (its handler of SIGINT and SIGTERM, Ctrl+C in a terminal),
+  // where Chromium did not close its browsers nor write its cookies until it ended, which it did only once the application had answered
+  // (KaSH: Chromium never stopped, and quitting took 20 to 25 s; from the Dock or the menu, with the mouse, it took 2 s). terminate: is
+  // called again from the top of the run loop, as the Dock's Quit.
+  const bool now = g_terminate_now;
+  g_terminate_now = false;
+  if (!now) {
+    [self performSelector:@selector(_terminateNow:)
+               withObject:sender
+               afterDelay:0
+                  inModes:@[ NSDefaultRunLoopMode, NSEventTrackingRunLoopMode, NSModalPanelRunLoopMode ]];
+    return;
+  }
+
   bool continueTerminate = true;
 
